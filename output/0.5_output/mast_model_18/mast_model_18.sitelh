# This file can be read in MS Excel or in R with command:
#   tab=read.table('/maps/projects/racimolab/people/fnl270/GitHub/mast_hiv/output/mast_model_18/mast_model_18.sitelh',header=TRUE,fill=TRUE)
# Columns are tab-separated with following meaning:
#   Site:   Alignment site ID
