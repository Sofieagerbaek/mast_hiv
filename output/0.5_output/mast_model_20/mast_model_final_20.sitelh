#   tab=read.table('/maps/projects/racimolab/people/fnl270/GitHub/mast_hiv/output/mast_model_20/mast_model_final_20.sitelh',header=TRUE,fill=TRUE)
# Columns are tab-separated with following meaning:
#   Site:   Alignment site ID
